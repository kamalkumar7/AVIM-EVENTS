generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generic key-value text config per section
model SiteConfig {
  id        String   @id @default(cuid())
  section   String
  key       String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([section, key])
}

// Hero slideshow images
model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tieup partner logos (marquee)
model TieupPartner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Hotel / property logos
model PropertyLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Testimonials carousel
model Testimonial {
  id        String   @id @default(cuid())
  author    String
  quote     String   @db.Text
  timeAgo   String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Portfolio gallery items
model PortfolioItem {
  id        String   @id @default(cuid())
  category  String
  title     String
  subtitle  String?
  imageUrl  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Team members
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  location    String?
  description String?  @db.Text
  initials    String?
  imageUrl    String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Counter stats (section: "home" | "about")
model CounterStat {
  id       String  @id @default(cuid())
  section  String
  value    Int
  suffix   String  @default("+")
  label    String
  sublabel String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Global milestones / achievements
model Milestone {
  id          String   @id @default(cuid())
  title       String
  badge       String?
  description String?  @db.Text
  location    String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Service cards (section: "home" | "services_main" | "services_more")
model ServiceCard {
  id          String   @id @default(cuid())
  section     String
  title       String
  description String   @db.Text
  bullets     String?  @db.Text
  imageUrl    String?
  icon        String?
  badge       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Gallery page items
model GalleryItem {
  id        String   @id @default(cuid())
  category  String
  title     String
  imageUrl  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Venue cards (tier: "palatial" | "elite")
model VenueCard {
  id       String  @id @default(cuid())
  name     String
  location String
  tag      String?
  tier     String
  imageUrl String?
  order    Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Career form submissions
model Applicant {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  role      String?
  message   String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Contact form enquiries
model Enquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  eventType String?
  eventDate String?
  message   String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
