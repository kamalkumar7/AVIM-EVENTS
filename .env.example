# PostgreSQL (Neon or any Postgres-compatible provider)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Cloudinary — use individual vars (NOT the raw CLOUDINARY_URL string)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# iron-session — any random 32+ character secret
IRON_SESSION_SECRET="change_me_to_a_random_32_char_secret"

# Admin login credentials
ADMIN_USERNAME="admin@avimevents"
ADMIN_PASSWORD="rty@avimevents%$HU"
